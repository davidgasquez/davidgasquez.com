---
import Layout from "../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { socialImagePath } from "../lib/social-image";
import { getStandardDocumentUrisByPath } from "../lib/standard-site";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  const standardDocuments = await getStandardDocumentUrisByPath();

  return blogEntries.map((entry) => {
    const standardDocumentUri = standardDocuments.get(`/${entry.id}`);
    if (!standardDocumentUri) {
      throw new Error(`Missing Standard.site document for /${entry.id}`);
    }

    return {
      params: { slug: entry.id },
      props: { entry, standardDocumentUri },
    };
  });
}

const { entry, standardDocumentUri } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} | David Gasquez`}
  image={socialImagePath("blog", entry.id, entry.data.title)}
  imageAlt={`${entry.data.title} by David Gasquez`}
  type="article"
  standardDocumentUri={standardDocumentUri}
>
  <article class="prose post">
    <header class="post-header">
      <h1>{entry.data.title}</h1>
      <time datetime={entry.data.date.toISOString()}>
        {entry.data.date.toLocaleDateString("en", { day: "numeric", month: "short", year: "numeric" })}
      </time>
    </header>
    <Content />
  </article>

  <div class="post-navigation text-center">
    <a href="/">← Back to home</a>
  </div>
</Layout>
